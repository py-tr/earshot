{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^execute_command$",
        "hooks": [
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe earshot_mcp\\bob_hook.py",
            "timeout": 900
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe earshot_mcp\\preflight.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
